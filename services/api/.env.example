XXX_ENVIRONMENT=development
XXX_DEBUG=false
XXX_ALLOWED_ORIGINS=["http://localhost:3000"]
XXX_DATABASE_URL=sqlite+aiosqlite:///./xxx-development.db
XXX_JWT_SIGNING_SECRET=development-only-jwt-secret-change-before-production
XXX_TOKEN_HASH_SECRET=development-only-token-secret-change-before-production
XXX_MFA_ENCRYPTION_SECRET=development-only-mfa-encryption-secret-change-before-production
XXX_MAX_ACTIVE_SESSIONS_PER_USER=10
XXX_REDIS_URL=redis://127.0.0.1:6379/0
XXX_ANALYSIS_STREAM_NAME=xxx:analysis
XXX_ANALYSIS_CONSUMER_GROUP=xxx-analysis-workers
XXX_ANALYSIS_LEASE_SECONDS=600
XXX_ANALYSIS_MAX_ATTEMPTS=3
XXX_ANALYSIS_VALIDATOR_COMMAND=xxx-analyzer
XXX_ANALYSIS_VALIDATOR_TIMEOUT_SECONDS=60
XXX_ANALYSIS_SANDBOX_MODE=process
XXX_ANALYSIS_BUBBLEWRAP_COMMAND=bwrap
XXX_STORAGE_ENDPOINT_URL=http://127.0.0.1:9000
XXX_STORAGE_REGION=us-east-1
XXX_STORAGE_BUCKET=xxx-private-models
XXX_STORAGE_ACCESS_KEY=development-minio
XXX_STORAGE_SECRET_KEY=development-minio-secret
XXX_PUBLIC_WEB_URL=http://localhost:3000
XXX_EMAIL_SENDER_ADDRESS=no-reply@example.com
XXX_EMAIL_SENDER_NAME=xxx
XXX_SMTP_HOST=127.0.0.1
XXX_SMTP_PORT=1025
XXX_SMTP_STARTTLS=false
XXX_SMTP_USE_TLS=false

# Disabled until merchant setup and the release checklist are approved.
XXX_RAZORPAY_ENABLED=false
XXX_WORKFLOW_NOTIFICATIONS_ENABLED=false
# Workflow notices reuse the approved SMTP sender and XXX_PUBLIC_WEB_URL. Disabled until approved.
XXX_NOTIFICATION_MAX_ATTEMPTS=5
XXX_RAZORPAY_MODE=test
# Configure credentials locally; never commit them or send them in chat.
# XXX_RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_ID
# XXX_RAZORPAY_CHECKOUT_NAME=YOUR_APPROVED_MERCHANT_NAME
# XXX_RAZORPAY_KEY_SECRET=YOUR_SERVER_ONLY_SECRET
# XXX_RAZORPAY_WEBHOOK_SECRET=YOUR_DISTINCT_WEBHOOK_SECRET

# Leave slicing disabled until the owner supplies reviewed, standalone AD5X profiles.
# Set ALL of these together, plus XXX_ANALYSIS_LEASE_SECONDS >= max_models * timeout + 120.
# XXX_ANALYSIS_SLICER_COMMAND=/opt/reviewed-orca/bin/orca-slicer
# XXX_ANALYSIS_SLICER_VERSION=OWNER_VERIFIED_BUILD_VERSION
# XXX_ANALYSIS_SLICER_SHA256=SHA256_OF_REVIEWED_EXECUTABLE
# XXX_ANALYSIS_PROFILE_DIRECTORY=/opt/approved-ad5x-profile
# XXX_ANALYSIS_PROFILE_SHA256=HASH_OF_MACHINE_PROCESS_FILAMENT_FILES
# XXX_ANALYSIS_MATERIAL_CODE=OWNER_APPROVED_MATERIAL_CODE
# XXX_ANALYSIS_SLICER_TIMEOUT_SECONDS=240
# XXX_ANALYSIS_LEASE_SECONDS=1800
